@model IEnumerable<SistemaRRHH.Models.Asistencias>

@{
    ViewData["Title"] = "Monitoreo de Asistencias - Admin";
    var empleadosDic = ViewBag.Empleados as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold"> Monitoreo Global de Asistencias</h2>
        <span class="badge bg-dark p-2 fs-6">Auditoría de Tiempos</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-secondary text-white fw-bold"> Registro General de Entradas y Salidas</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Empleado</th>
                            <th>Fecha Laboral</th>
                            <th>Hora Entrada</th>
                            <th>Hora Salida</th>
                            <th class="pe-3 text-end">Horas Totales Trabajadas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No se han registrado marcas de asistencia en el sistema.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                string nombreEmpleado = empleadosDic.ContainsKey(item.EmpleadoId)
                                    ? empleadosDic[item.EmpleadoId]
                                    : $"Empleado #{item.EmpleadoId}";

                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@nombreEmpleado</td>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-success">@item.HoraEntrada.ToString("hh:mm tt")</span></td>
                                    <td>
                                        @if (item.HoraSalida.HasValue)
                                        {
                                            <span class="badge bg-danger">@item.HoraSalida.Value.ToString("hh:mm tt")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">En Turno / Activo</span>
                                        }
                                    </td>
                                    <td class="pe-3 text-end fw-bold text-secondary">
                                        @if (item.HoraSalida.HasValue)
                                        {
                                            @string.Format("{0:0.00} hrs", item.HorasTrabajadas)
                                        }
                                        else
                                        {
                                            <span>--</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

