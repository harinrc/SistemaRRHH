@model IEnumerable<SistemaRRHH.Models.SolicitudesVacaciones>

@{
    ViewData["Title"] = "Aprobación de Vacaciones - Admin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold"> Panel de Aprobación de Vacaciones</h2>
        <span class="badge bg-primary p-2 fs-6">Rol: Administrador</span>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
             @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">ID Empleado</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Días Solicitados</th>
                            <th>Comentarios</th>
                            <th>Estado</th>
                            <th class="text-center pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No hay solicitudes de vacaciones registradas en el sistema.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">#@item.EmpleadoId</td>
                                    <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-secondary">@item.DiasSolicitados días</span></td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(item.Comentarios) ? "Sin comentarios" : item.Comentarios)</td>
                                    <td>
                                        <span class="badge @(item.Estado == "Pendiente" ? "bg-warning text-dark" : item.Estado == "Aprobado" ? "bg-success" : "bg-danger")">
                                            @item.Estado
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        @if (item.Estado == "Pendiente")
                                        {
                                            <form asp-action="Aprobar" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-success btn-sm fw-bold px-3 shadow-sm">
                                                    ✓ Aprobar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-light btn-sm text-muted" disabled>Procesada</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
